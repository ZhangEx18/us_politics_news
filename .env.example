# 新闻分析系统环境变量配置
# 复制此文件为 .env 并填入真实密钥

# NewsAPI (https://newsapi.org/register)
NEWSAPI_KEY=

# TianAPI (https://www.tianapi.com/)
TIANAPI_KEY=

# AI 分析（中文标题+摘要+深度解读）
# 支持任意 OpenAI 兼容 API（示例：OpenCode Zen Go）
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_MODEL=deepseek-v4.1-flash

# VPS 发布凭据（publish_daily.sh 自动 git push 用）
GIT_PUSH_TOKEN=
GIT_PUSH_REPO=
GIT_PUSH_BRANCH=main
